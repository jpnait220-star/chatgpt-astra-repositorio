; Last Zone — native Godot project. Open with Godot 4.6.3 or newer 4.6.x.
config_version=5

[application]
config/name="LAST ZONE · Godot"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=2048
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.43, 0.65, 0.78, 1)

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=22.0
