{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm test",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/profile",
      "destination": "/api/relay?route=profile"
    },
    {
      "source": "/profiles",
      "destination": "/api/relay?route=profiles"
    },
    {
      "source": "/health",
      "destination": "/api/relay?route=health"
    },
    {
      "source": "/community",
      "destination": "/api/relay?route=community"
    },
    {
      "source": "/chat",
      "destination": "/api/relay?route=chat"
    },
    {
      "source": "/announcements",
      "destination": "/api/relay?route=announcements"
    },
    {
      "source": "/announcement-challenge",
      "destination": "/api/relay?route=announcement-challenge"
    },
    {
      "source": "/announce",
      "destination": "/api/relay?route=announce"
    },
    {
      "source": "/updates",
      "destination": "https://raw.githubusercontent.com/jpnait220-star/chatgpt-astra-repositorio/asasa/downloads/DuckClientZ-update.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        }
      ]
    }
  ]
}
